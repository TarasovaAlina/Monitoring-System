{
    "agent": {
        "type": "CPU_AGENT",
        "update_interval": 500,
        "critical_metrics": {
            "cpu": {
                "operator": ">=",
                "value": 80
            },
            "processes": {
                "operator": ">=",
                "value": 80
            }
        }
    },
    "copy_agent": {
        "type": "MEMORY_AGENT",
        "update_interval": 1000,
        "critical_metrics": {
            "ram_total": {
                "operator": ">=",
                "value": 80
            },
            "ram": {
                "operator": ">=",
                "value": 80
            },
            "hard_ops": {
                "operator": ">=",
                "value": 80
            }
        }
    }
}
