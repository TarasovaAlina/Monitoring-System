{
    "agents": [
        {
            "name": "cpu",
            "type": "CPU_AGENT",
            "update_interval": 5,
            "critical_metrics": [
                {
                    "name": "cpu",
                    "operator": ">=",
                    "value": 80
                },
                {
                    "name": "processes",
                    "operator": ">=",
                    "value": 80
                }
            ]
        },
        {
            "name": "memory",
            "type": "MEMORY_AGENT",
            "update_interval": 5,
            "critical_metrics": [
                {
                    "name": "ram",
                    "operator": ">=",
                    "value": 90
                },
                {
                    "name": "hard_volume",
                    "operator": ">=",
                    "value": 80
                },
                {
                    "name": "hard_ops",
                    "operator": ">=",
                    "value": 80
                },
                {
                    "name": "hard_throughput",
                    "operator": ">=",
                    "value": 80
                }
            ]
        },
        {
            "name": "network",
            "type": "NETWORK_AGENT",
            "update_interval": 5,
            "critical_metrics": [
                {
                    "name": "https://example.com",
                    "operator": "==",
                    "value": 0
                },
                {
                    "name": "inet_throughput",
                    "operator": "==",
                    "value": 0
                }
            ]
        }
    ]
}

